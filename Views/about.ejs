<%- include('partials/header') %>

<section class="bg-white py-5 border-bottom">
    <div class="container text-center">
        <h6 class="text-danger fw-bold text-uppercase">Our Mission</h6>
        <h1 class="display-5 fw-bold mb-3"><%= projectName %></h1>
        <p class="lead text-muted mx-auto" style="max-width: 700px;">
            <%= description %>
        </p>
    </div>
</section>

<section class="container my-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold">Meet Our Team</h2>
        <p class="text-muted">The developers behind this platform</p>
    </div>

    <div class="row g-4 justify-content-center">
        <% aboutitems.forEach(member => { %>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="text-center">
                    <div class="bg-light rounded-circle shadow-sm d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 100px; height: 100px; border: 2px solid #ff4d4d;">
                        <i class="bi bi-person-fill fs-1 text-secondary"></i>
                    </div>
                    <h5 class="fw-bold mb-0"><%= member.name %></h5>
                    <small class="text-danger">Developer</small>
                </div>
            </div>
        <% }) %>
    </div>
</section>

<div class="container mb-5">
    <div class="bg-dark text-white p-5 rounded-4 shadow">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h3 class="fw-bold">Innovation in Fitness</h3>
                <p class="mb-0 opacity-75">We utilize Node.js, Express, and EJS to provide a seamless user experience for the fitness community in Jordan.</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <i class="bi bi-code-slash display-1 text-danger opacity-25"></i>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>