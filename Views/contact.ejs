<%- include('partials/header') %>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div style="height: 10px; background-color: #ff4d4d;"></div>
                
                <div class="card-body p-5 text-center">
                    <h1 class="fw-bold mb-4">Get In Touch</h1>
                    <p class="text-muted mb-5">Have questions? We are here to help you start your journey.</p>

                    <% if (success) { %>
                        <div class="alert alert-success text-start mb-4" role="alert">
                            <%= success %>
                        </div>
                    <% } %>

                    <% if (error) { %>
                        <div class="alert alert-danger text-start mb-4" role="alert">
                            <%= error %>
                        </div>
                    <% } %>

                    <div class="d-flex align-items-center justify-content-start mb-4 p-3 bg-light rounded-3">
                        <i class="bi bi-telephone-fill fs-3 text-danger me-4"></i>
                        <div class="text-start">
                            <small class="text-uppercase fw-bold text-muted d-block">Phone</small>
                            <span class="fs-5 fw-semibold"><%= contactitems.phone %></span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-start mb-4 p-3 bg-light rounded-3">
                        <i class="bi bi-envelope-at-fill fs-3 text-danger me-4"></i>
                        <div class="text-start">
                            <small class="text-uppercase fw-bold text-muted d-block">Email</small>
                            <span class="fs-5 fw-semibold"><%= contactitems.email %></span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-start mb-5 p-3 bg-light rounded-3">
                        <i class="bi bi-geo-alt-fill fs-3 text-danger me-4"></i>
                        <div class="text-start">
                            <small class="text-uppercase fw-bold text-muted d-block">Location</small>
                            <span class="fs-5 fw-semibold"><%= contactitems.location %></span>
                        </div>
                    </div>

                    <hr class="my-4 text-muted">

                    <form action="/contact" method="POST" class="text-start">
                        <div class="mb-3">
                            <label for="name" class="form-label fw-semibold text-muted">Name</label>
                            <input type="text" class="form-border form-control p-3 rounded-3" id="name" name="name" required>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label fw-semibold text-muted">Email</label>
                            <input type="email" class="form-border form-control p-3 rounded-3" id="email" name="email" required>
                        </div>
                        <div class="mb-4">
                            <label for="message" class="form-label fw-semibold text-muted">Message</label>
                            <textarea class="form-border form-control p-3 rounded-3" id="message" name="message" rows="4" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-danger w-100 py-3 fw-bold rounded-3" style="background-color: #ff4d4d; border: none;">Send Message</button>
                    </form>
                </div>

                <div class="card-footer bg-dark text-center py-3">
                    <span class="text-white-50">Open Daily: 6:00 AM - 11:00 PM</span>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>