<%- include('partials/header') %>
<header class="bg-dark text-white text-center py-5 mb-5 shadow-sm">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3"><%= title %></h1>
        <p class="lead opacity-75"><%= message %></p>
        <a href="#features" class="btn btn-danger btn-lg px-4 mt-3 fw-bold text-uppercase">Start Now</a>
    </div>
</header>

<section id="features" class="container pb-5">
    <div class="row g-4 justify-content-center">
        <% homeitems.forEach(item => { %>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm text-center p-4 rounded-4" style="transition: transform 0.3s ease;">
                    <div class="card-body">
                        <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                            <i class="bi <%= item.icon %> fs-1 text-danger"></i>
                        </div>
                        
                        <h4 class="card-title fw-bold text-dark"><%= item.title %></h4>
                        <p class="card-text text-muted px-2">
                            <%= item.desc %>
                        </p>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</section>

<div class="container mt-4 mb-5">
    <div class="bg-light p-5 rounded-5 text-center border">
        <h2 class="fw-bold">Ready to join the family?</h2>
        <p class="text-muted">Limited offer: Join today and get 20% off your first month!</p>
    </div>
</div>
<%- include('partials/footer') %>
