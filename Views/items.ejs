<%- include('partials/header') %>

<div class="container my-5">

    <div class="row mb-4 align-items-center">

        <div class="col">
            <h2 class="fw-bold">
                <i class="bi bi-list-check text-danger"></i>
                Equipment Status
            </h2>

            <p class="text-muted">
                Real-time availability of gym machines and gear.
            </p>
        </div>

    </div>

    <div class="card shadow-sm border-0 rounded-3">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-dark">

                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Equipment Name</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>

                </thead>

                <tbody>

                    <% itemsitems.forEach(item => { %>

                        <tr>

                            <td class="ps-4 text-muted">
                                <%= item._id %>
                            </td>

                            <td>
                                <span class="fw-bold">
                                    <%= item.name %>
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-light text-dark border">
                                    <%= item.type %>
                                </span>
                            </td>

                            <td>

                                <% if(item.status === 'Available') { %>

                                    <span class="badge bg-success-subtle text-success px-3">
                                        <i class="bi bi-check-circle-fill me-1"></i>
                                        Available
                                    </span>

                                <% } else { %>

                                    <span class="badge bg-danger-subtle text-danger px-3">
                                        <i class="bi bi-x-circle-fill me-1"></i>
                                        Busy
                                    </span>

                                <% } %>

                            </td>

                            <td class="text-center">

                                <a href="/items/<%= item._id %>"
                                   class="btn btn-sm btn-outline-danger shadow-sm">

                                    <i class="bi bi-info-circle me-1"></i>
                                    View Details

                                </a>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </div>

</div>

<%- include('partials/footer') %>