<!DOCTYPE html>
<html>
<head>
    <title>Join Us | GymApp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        body {
            background-color: #f8f9fa;
        }
        .register-card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        .card-header {
            background-color: #0d6efd; /* لون أزرق لتمييز التسجيل */
            color: white;
            border-radius: 15px 15px 0 0 !important;
            padding: 20px;
        }
        .btn-primary {
            padding: 10px;
            font-weight: bold;
            border-radius: 8px;
        }
        .error-text {
            font-size: 0.85rem;
            margin-top: 4px;
            display: block;
        }
    </style>
</head>
<body>

<%- include('partials/header') %>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6"> 
            <div class="card register-card">
                <div class="card-header text-center">
                    <h3 class="mb-0"><i class="bi bi-person-plus"></i> Create New Account</h3>
                </div>
                
                <div class="card-body p-4">
                    <form action="/register" method="POST">
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Full Name</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input type="text" name="name" 
                                       class="form-control <%= errors?.name ? 'is-invalid' : '' %>" 
                                       placeholder="Enter your name"
                                       value="<%= oldInput?.name || '' %>">
                            </div>
                            <% if (errors?.name) { %>
                                <small class="text-danger error-text"><i class="bi bi-x-circle"></i> <%= errors.name %></small>
                            <% } %>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input type="text" name="email" 
                                       class="form-control <%= errors?.email ? 'is-invalid' : '' %>" 
                                       placeholder="name@example.com"
                                       value="<%= oldInput?.email || '' %>">
                            </div>
                            <% if (errors?.email) { %>
                                <small class="text-danger error-text"><i class="bi bi-x-circle"></i> <%= errors.email %></small>
                            <% } %>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                                <input type="password" name="password" 
                                       class="form-control <%= errors?.password ? 'is-invalid' : '' %>" 
                                       placeholder="Min. 5 characters">
                            </div>
                            <% if (errors?.password) { %>
                                <small class="text-danger error-text"><i class="bi bi-x-circle"></i> <%= errors.password %></small>
                            <% } %>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary shadow-sm">
                                <i class="bi bi-check-circle"></i> Complete Registration
                            </button>
                        </div>
                    </form>
                </div>
                
                <div class="card-footer text-center py-3 bg-white">
                    <small class="text-muted">Already a member? <a href="/login" class="text-primary text-decoration-none fw-bold">Login here</a></small>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>