<%- include('partials/header') %>

<div class="container mt-5">

    <h2 class="mb-4 text-center fw-bold">Search</h2>

 
    <form method="GET" action="/search" class="mb-5 text-center">
        <input 
            type="text" 
            name="q" 
            value="<%= query || '' %>" 
            placeholder="Search members or services..."
            class="form-control w-50 d-inline me-2"
        >
        <button class="btn btn-danger">Search</button>
    </form>

   
    <h4 class="fw-bold">Members</h4>
    <div class="row g-3 mb-4">
        <% memberResults.forEach(m => { %>
            <div class="col-md-4">
                <div class="card shadow-sm p-3">
                    <h5><%= m.name %></h5>
                    <p class="text-muted">Plan: <%= m.plan %></p>
                </div>
            </div>
        <% }) %>
    </div>

    <!-- SERVICES -->
    <h4 class="fw-bold">Services</h4>
    <div class="row g-3">
        <% serviceResults.forEach(s => { %>
            <div class="col-md-4">
                <div class="card shadow-sm p-3">
                    <h5><%= s.name %></h5>
                </div>
            </div>
        <% }) %>
    </div>

</div>

<%- include('partials/footer') %>